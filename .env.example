# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env
BASE_URL=https://crm.anhtester.com
TEST_USERNAME=<email tài khoản admin test>
TEST_PASSWORD=<mật khẩu tài khoản admin test>

# Tài khoản tuỳ chọn — thiếu thì TC tương ứng tự skip
PM_EMAIL=<email Project Manager>
PM_PASSWORD=<mật khẩu Project Manager>
CUSTOMER_EMAIL=<email tài khoản cổng khách hàng>
CUSTOMER_PASSWORD=<mật khẩu tài khoản cổng khách hàng>
TC014_EMAIL=<email staff có mật khẩu chứa chữ cái>
TC014_PASSWORD=<mật khẩu staff đó>

# false = mở browser thật (debug local) · true = headless (CI)
HEADLESS=false
# Số luồng chạy song song — chỉnh DUY NHẤT ở đây
WORKERS=5
TIMEOUT=30000
